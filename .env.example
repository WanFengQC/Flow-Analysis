# 本地 AI 配置模板。复制为 .env 后填写；.env 已由 Git 忽略。
UNIAPI_API_KEY=

# 源码开发/测试可使用下列外部 PostgreSQL 配置。正式安装包不读取该文件，
# 而是在构建阶段从受保护的 FLOW_ANALYSIS_BUILD_CONFIG_PATH 内嵌完整配置。
# 不要使用管理员账号；这些值绝不能提交到 Git。
FLOW_ANALYSIS_DB_HOST=
FLOW_ANALYSIS_DB_PORT=5432
FLOW_ANALYSIS_DB_NAME=
FLOW_ANALYSIS_DB_USER=
FLOW_ANALYSIS_DB_PASSWORD=
FLOW_ANALYSIS_DB_SSLMODE=prefer

# 必须填写 UniAPI 控制台 /models 返回的真实 model ID，显示名称不能代替它。
TAGGING_GPT_MODEL=
TAGGING_CLAUDE_MODEL=
TAGGING_GEMINI_MODEL=
